# Main API: Apps Script Web App URL (apps-script/), ends with /exec.
# Leave empty to run in demo mode (local mock server, no Google needed).
VITE_APPS_SCRIPT_URL=

# Google login via the companion Apps Script (apps-script-login/), ends with /exec.
VITE_LOGIN_URL=

# Optional alternative to VITE_LOGIN_URL: OAuth 2.0 Web client ID (Google Identity Services button).
VITE_GOOGLE_CLIENT_ID=
